# Postgres connection string. Use Neon/Supabase Postgres in production.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BRIDGE_API_KEY=replace-with-a-long-random-secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-fernet-key

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/auth/callback
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
MAX_ATTACHMENT_BYTES=15728640
